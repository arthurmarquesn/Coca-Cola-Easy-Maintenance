# Copie para .env.production na raiz do repositório, na VM:
#   cp deploy/env.production.example .env.production && chmod 600 .env.production
# Nunca versione o .env.production.

# --- Endereço público (Caddy) ---
DOMAIN=easymaintenance.duckdns.org
ACME_EMAIL=

# --- Banco (MySQL HeatWave, sub-rede privada) ---
DB_HOST=
DB_PORT=3306
DB_USER=easy_app
DB_PASSWORD=
DB_NAME=coca_cola_maintenance
DB_SSL=true
DB_SSL_CA=/run/secrets/db-ca.pem
DB_SSL_VERIFY_HOSTNAME=false

# --- Sessão: gere um novo com `openssl rand -hex 32` ---
AUTH_SECRET=

# --- ML (rede interna do Compose) ---
# Gere com `openssl rand -hex 32`.
ML_SERVICE_TOKEN=
URSUS_MODEL_VERSION=v1.6

# --- Login: header que o Caddy sobrescreve com o IP do cliente ---
LOGIN_TRUSTED_IP_HEADER=x-real-ip

# --- IA externa desligada: enviaria observações a terceiros ---
GROQ_API_KEY=
